<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Compile against a pinned accepted binary; run that binary, not a rebuilt host. -->
    <Reference Include="GrandUMIServer">
      <HintPath>$(L12ServerAssemblyRoot)/GrandUMIServer.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireExplicitAcceptedServer" BeforeTargets="ResolveReferences">
    <Error Condition="'$(L12ServerAssemblyRoot)' == '' Or !Exists('$(L12ServerAssemblyRoot)/GrandUMIServer.dll')"
           Text="Require an explicit accepted server assembly root." />
  </Target>
</Project>
