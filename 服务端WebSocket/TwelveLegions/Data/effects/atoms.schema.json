{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legion12.local/schemas/effect-atoms.schema.json",
  "title": "Legion12 原子化卡效定义",
  "type": "object",
  "required": ["schemaVersion", "cardId", "abilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cardId": { "type": "string", "pattern": "^S[0-9]{2}-" },
    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["abilityId", "text", "trigger", "atoms", "migrationStatus"],
        "properties": {
          "abilityId": { "type": "string" },
          "text": { "type": "string" },
          "trigger": { "type": "string" },
          "migrationStatus": {
            "enum": ["legacy-backed", "partially-atomized", "declarative-ready", "runtime-migrated", "verified"]
          },
          "atoms": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["atomId", "kind", "order", "parameters"],
              "properties": {
                "atomId": { "type": "string" },
                "kind": { "type": "string" },
                "order": { "type": "integer", "minimum": 1 },
                "parameters": { "type": "object", "additionalProperties": { "type": "string" } },
                "source": { "enum": ["card-text", "inferred", "override", "migration-guard"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
