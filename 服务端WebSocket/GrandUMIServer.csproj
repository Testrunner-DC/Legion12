<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GrandUMIServer</AssemblyName>
    <RootNamespace>TwelveLegions.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <!--
    The production host is Legion12-only. Keep the boundary explicit so retired
    GrandUMI reference sources cannot silently return to the published server.
  -->
  <ItemGroup>
    <Compile Remove="Cards\**\*.cs" />
    <Compile Remove="Effects\**\*.cs" />
    <Compile Remove="Game\**\*.cs" />
    <Compile Remove="BugReportStore.cs" />
    <Compile Remove="WebSocketBridge.cs" />
    <Compile Remove="WsSession.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TwelveLegions\Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TwelveLegions\Data\effects\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
