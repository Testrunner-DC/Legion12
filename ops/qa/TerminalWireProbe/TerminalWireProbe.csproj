<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="GrandUMIServer"><HintPath>$(L12AcceptedServerRoot)/GrandUMIServer.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequirePinnedServer" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(L12AcceptedServerRoot)/GrandUMIServer.dll')" Text="An explicit accepted server assembly is required." />
  </Target>
</Project>
