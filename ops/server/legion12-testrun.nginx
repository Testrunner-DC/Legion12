server {
    listen 80;
    listen [::]:80;
    server_name testrun.legion-12.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name testrun.legion-12.com;
    client_max_body_size 1m;

    ssl_certificate /etc/letsencrypt/live/testrun.legion-12.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/testrun.legion-12.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:Legion12TestrunTls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /ws {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://127.0.0.1:8084;
    }

    location ^~ /api/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8084;
    }

    location = /health {
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:8084;
    }

    location = /cards {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files /index.html =404;
    }

    location = /cards/ {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files /index.html =404;
    }

    location = /card-assets/card-assets.manifest.json {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files $uri =404;
        etag on;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
    }

    location = /card-assets/card-assets.preload.json {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files $uri =404;
        etag on;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
    }

    location ~ "^/card-assets/cards/[A-Za-z0-9._-]+/S[0-9]{2}-[A-Za-z0-9]+/[0-9a-f]{20}/[A-Za-z0-9._-]+\.(?:webp|avif)$" {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files $uri =404;
        etag on;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /card-assets/ {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files $uri =404;
        etag on;
        add_header Cache-Control "no-store" always;
    }

    location / {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files $uri $uri/ /index.html;
    }
}
