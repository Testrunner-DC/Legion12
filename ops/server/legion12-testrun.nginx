# 本文件由 nginx.conf 的 http 块 include，因此 upstream 块写在这里（http 上下文）；
# 写进 server/location 块会让 nginx -t 直接失败。
# 与主站的 ops/server/nginx-l12-upstream-keepalive.conf 同构：同一 upstream 写法、同一 keepalive 32。
upstream l12_testrun_app {
    # 测试服仍是单机同源后端 127.0.0.1:8084，不引入负载均衡或超时变更。
    server 127.0.0.1:8084;
    # 每 worker 缓存 32 条空闲长连接；Kestrel 空闲超时默认 130s 大于 nginx
    # keepalive_timeout 默认 60s，因此总是 nginx 先关空闲连接。
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name testrun.legion-12.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name testrun.legion-12.com;
    client_max_body_size 1m;

    ssl_certificate /etc/letsencrypt/live/testrun.legion-12.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/testrun.legion-12.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:Legion12TestrunTls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # 文本资产压缩。与主站 ops/server/nginx-l12-gzip.conf 逐行同构：同一批 gzip_* 指令、
    # 同一 gzip_min_length 1024 阈值；两侧调整必须同步。这里放在 server 上下文，
    # 不含 add_header，因此不会覆盖任何 location 的 Cache-Control 或安全头集合。
    # 已压缩格式（jpeg/png/webp/avif/gif、video/*、audio/*、字体、zip/pdf）不列入
    # gzip_types，即不压缩；text/html 在 gzip on 时由 nginx 无条件压缩。
    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        application/xml
        application/xhtml+xml
        image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /ws {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://127.0.0.1:8084;
    }

    # Only the authenticated site-media endpoint accepts the original plus
    # three generated variants. Keep the server-wide 1m guard for every other API.
    # 该路由此处保持直连 127.0.0.1:8084：64m 大文件上传不进入 /api 的 keepalive 池，
    # 避免长连接被单次上传长期占用；与主站同名精确路由的直连写法一致。
    location = /api/admin/site/media {
        client_max_body_size 64m;
        error_page 413 = @site_media_too_large;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8084;
    }

    location @site_media_too_large {
        default_type application/json;
        return 413 '{"code":"media_upload_too_large","message":"图片上传总量不能超过 64MB，请压缩原图后重试"}';
    }

    # /api 反代复用后端长连接。keepalive 三件套必须齐全：proxy_http_version 1.1、
    # 把 Connection 置空（不发送 close）、upstream 内的 keepalive。缺任何一件时 nginx
    # 仍按 HTTP/1.0 逐请求重建 TCP，弱网下每个接口都要多付一次握手。
    # 既有 proxy_set_header 与缓存语义全部保持原样。
    location ^~ /api/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://l12_testrun_app;
    }

    location = /health {
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:8084;
    }

    location = / {
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-L12-Share-Path $uri;
        proxy_pass http://127.0.0.1:8084/_l12/share-page;
    }

    location = /news {
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-L12-Share-Path $uri;
        proxy_pass http://127.0.0.1:8084/_l12/share-page;
    }

    location = /news/ {
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-L12-Share-Path $uri;
        proxy_pass http://127.0.0.1:8084/_l12/share-page;
    }

    location ~ ^/news/[^/]+/?$ {
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;
        set $l12_share_path $uri;
        rewrite ^ /_l12/share-page break;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-L12-Share-Path $l12_share_path;
        proxy_pass http://127.0.0.1:8084;
    }

    location = /cards {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files /index.html =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /cards/ {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files /index.html =404;
        add_header Cache-Control "no-cache" always;
    }

    location ^~ /assets/ {
        root /opt/legion12-testrun-web-assets;
        try_files $uri =404;
        etag on;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ~ "^/data/l12/(?:cards\.(?:s1|lookup|st)|preset-decks\.s[12])\.json$" {
        root /opt/legion12-testrun/opcgpro-vue/dist-testrun;
        try_files $uri =404;
        etag on;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location ~ "^/data/(?:imageManifest|allCards|(?:OP|EB|ST|P|PRB|OPD|TY)[A-Z0-9]*)\.json$" {
        root /opt/legion12-testrun/opcgpro-vue/dist-testrun;
        try_files $uri =404;
        etag on;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /index.html {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files /index.html =404;
        etag on;
        add_header Cache-Control "no-cache" always;
    }

    location = /card-assets/card-assets.manifest.json {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files $uri =404;
        etag on;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
    }

    location = /card-assets/card-assets.preload.json {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files $uri =404;
        etag on;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
    }

    location ~ "^/card-assets/cards/[A-Za-z0-9._-]+/S[0-9]{2}-[A-Za-z0-9]+/[0-9a-f]{20}/[A-Za-z0-9._-]+\.(?:webp|avif)$" {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files $uri =404;
        etag on;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /card-assets/ {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files $uri =404;
        etag on;
        add_header Cache-Control "no-store" always;
    }

    location / {
        root /opt/legion12-testrun/opcgpro-vue/dist;
        try_files $uri $uri/ /index.html;
    }
}
