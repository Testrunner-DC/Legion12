# Bootstrap-only ACME virtual host. It deliberately does not expose the app
# over plaintext HTTP. Keep it enabled only until the certificate exists, then
# activate legion12-testrun.nginx with activate-l12-testrun-tls.sh.
server {
    listen 80;
    listen [::]:80;
    server_name testrun.legion-12.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        add_header Retry-After 300 always;
        default_type text/plain;
        return 503 'testrun TLS bootstrap in progress\n';
    }
}
