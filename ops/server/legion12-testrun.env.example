# Installed as /etc/legion12-testrun.env with owner root:root and mode 0600.
# bootstrap-l12-testrun.sh creates a random 64-hex-character admin password.
# Keep this file independent from every production environment file.
L12_ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
L12_EMAIL_FEATURE_ENABLED=false
L12_PUBLIC_BASE_URL=https://testrun.legion-12.com
# Storage cleanup uses the same low-traffic window in both environments.
# Times are UTC+8 regardless of the server operating-system timezone.
L12_STORAGE_CLEANUP_TIME=04:00
L12_STORAGE_CLEANUP_BUDGET_SECONDS=10
# Enable only with the isolated physical runtime and exact testrun HTTPS origin.
L12_STORAGE_RETENTION_ENVIRONMENT=testrun
L12_SMTP_HOST=
L12_SMTP_PORT=
L12_SMTP_USERNAME=
L12_SMTP_PASSWORD=
L12_SMTP_FROM_ADDRESS=
L12_SMTP_FROM_NAME=
L12_SMTP_ENABLE_SSL=
L12_ENABLE_SECOND_APPROVER_BOOTSTRAP=false
L12_SECOND_APPROVER_BOOTSTRAP_TOKEN=
