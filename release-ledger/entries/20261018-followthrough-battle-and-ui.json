    {
      "category": "battle",
      "text": "编辑牌库时也能收到原有好友约战提醒；不会自动跳转或丢失草稿，接受和拒绝仍由玩家选择。",
      "paths": ["opcgpro-vue/src/App.vue", "opcgpro-vue/src/l12/site/FriendChallengeNotifications.vue", "opcgpro-vue/src/l12/site/SiteShell.vue"]
