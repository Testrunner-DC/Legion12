        "opcgpro-vue/src/l12/game/mobileBattleDock.ts",
        "opcgpro-vue/src/l12/game/MobileBattleDock.vue",
        "opcgpro-vue/src/l12/game/OsirisVictorySequence.vue",
        "opcgpro-vue/src/l12/mobileViewport.css"
      ]
    },
    {
      "category": "replays",
      "text": "回放播放、暂停、进度和返回控件在回放蒙版出现时仍保持可见可操作，回放画面本身继续受到蒙版保护。",
      "paths": [
